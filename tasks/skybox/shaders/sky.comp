#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform writeonly image2DArray skyImage;

layout(push_constant) uniform Params {
  vec4 sun;
  vec4 color;
  vec4 clouds;
  vec4 layer;
  ivec4 work;
} params;

const int NOISE_OCTAVES = 4;
const vec3 HORIZON_COLOR = vec3(0.46, 0.64, 0.88);
const vec3 ZENITH_COLOR = vec3(0.035, 0.12, 0.32);
const vec3 CLOUD_AMBIENT = vec3(0.32, 0.40, 0.53);

float hash(vec3 p)
{
  p = fract(p * 0.1031);
  p += dot(p, p.yxz + 33.33);
  return fract((p.x + p.y) * p.z);
}

float noise3(vec3 p)
{
  vec3 cell = floor(p);
  vec3 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);

  float a = mix(hash(cell), hash(cell + vec3(1, 0, 0)), f.x);
  float b = mix(hash(cell + vec3(0, 1, 0)), hash(cell + vec3(1, 1, 0)), f.x);
  float c = mix(hash(cell + vec3(0, 0, 1)), hash(cell + vec3(1, 0, 1)), f.x);
  float d = mix(hash(cell + vec3(0, 1, 1)), hash(cell + vec3(1, 1, 1)), f.x);

  return mix(mix(a, b, f.y), mix(c, d, f.y), f.z);
}

float fbm(vec3 p)
{
  float result = 0.0;
  float amplitude = 0.5;
  float weight = 0.0;

  for (int i = 0; i < NOISE_OCTAVES; ++i) {
    result += amplitude * noise3(p);
    weight += amplitude;
    p = p * 2.03 + vec3(11.1, 7.7, 13.3);
    amplitude *= 0.5;
  }

  return result / weight;
}

float cloudDensity(vec3 p)
{
  float height = (p.y - params.layer.x) / (params.layer.y - params.layer.x);
  float edge = smoothstep(0.0, 0.20, height) * (1.0 - smoothstep(0.75, 1.0, height));
  edge *= 1.0 - smoothstep(params.layer.z * 0.7, params.layer.z, length(p));
  if (edge <= 0.0) {
    return 0.0;
  }

  float field = fbm(p * params.clouds.z);
  float threshold = 1.0 - params.clouds.x;
  return smoothstep(threshold, threshold + 0.20, field) * edge * params.clouds.y;
}

float cloudShadow(vec3 p)
{
  float distance = min((params.layer.y - p.y) / params.sun.y, params.layer.z);
  float stepSize = distance / float(params.work.w);
  float densitySum = 0.0;

  for (int i = 0; i < params.work.w; ++i) {
    vec3 point = p + params.sun.xyz * ((float(i) + 0.5) * stepSize);
    densitySum += cloudDensity(point) * stepSize;
    if (densitySum > 6.0) {
      break;
    }
  }

  return exp(-densitySum);
}

vec3 skyColor(vec3 rayDir)
{
  float t = clamp(rayDir.y * 0.5 + 0.5, 0.0, 1.0);
  vec3 color = mix(HORIZON_COLOR, ZENITH_COLOR, t);
  float theta = acos(clamp(dot(rayDir, params.sun.xyz), -1.0, 1.0));
  float core = exp(-theta * theta * 9000.0);
  float halo = exp(-theta * 42.0);

  return color + params.color.rgb * params.sun.w * (core + halo);
}

vec4 traceClouds(vec3 rayDir, vec3 background)
{
  if (rayDir.y <= 0.0) {
    return vec4(background, 1.0);
  }

  float start = params.layer.x / rayDir.y;
  float finish = min(params.layer.y / rayDir.y, params.layer.z);
  if (finish <= start) {
    return vec4(background, 1.0);
  }

  float stepSize = (finish - start) / float(params.work.z);
  float transmission = 1.0;
  vec3 color = vec3(0.0);
  vec3 sunlight = params.color.rgb * params.sun.w * 0.15;
  float offset = hash(rayDir * 1024.0);

  for (int i = 0; i < params.work.z; ++i) {
    vec3 point = rayDir * (start + (float(i) + offset) * stepSize);
    float density = cloudDensity(point);
    if (density <= 0.0001) {
      continue;
    }

    float opacity = 1.0 - exp(-density * stepSize);
    vec3 light = CLOUD_AMBIENT + sunlight * cloudShadow(point);
    color += transmission * opacity * light;
    transmission *= 1.0 - opacity;
    if (transmission < 0.01) {
      break;
    }
  }

  return vec4(background * transmission + color, transmission);
}

vec3 getDirection(ivec2 pixel, int face, ivec2 size)
{
  vec2 uv = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  if (face == 0) {
    return normalize(vec3(1.0, -uv.y, -uv.x));
  }
  if (face == 1) {
    return normalize(vec3(-1.0, -uv.y, uv.x));
  }
  if (face == 2) {
    return normalize(vec3(uv.x, 1.0, uv.y));
  }
  if (face == 3) {
    return normalize(vec3(uv.x, -1.0, -uv.y));
  }
  if (face == 4) {
    return normalize(vec3(uv.x, -uv.y, 1.0));
  }

  return normalize(vec3(-uv.x, -uv.y, -1.0));
}

void main()
{
  ivec2 pixel = ivec2(gl_GlobalInvocationID.xy) + ivec2(0, params.work.y);
  ivec2 size = imageSize(skyImage).xy;
  if (any(greaterThanEqual(pixel, size))) {
    return;
  }

  vec3 rayDir = getDirection(pixel, params.work.x, size);
  vec3 background = skyColor(rayDir);
  vec4 color = traceClouds(rayDir, background);
  imageStore(skyImage, ivec3(pixel, params.work.x), color);
}
